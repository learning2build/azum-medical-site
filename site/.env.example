# --- Resend (required) ---
# https://resend.com — API key + verified sending domain for production
RESEND_API_KEY=re_ZwMy2rSS_8KdHRjUxKuzxthM3HZJg5uDn

# Inbox for contact form (required). Do not commit real addresses in code; set per environment.
CONTACT_EMAIL_TO=cryph00@gmail.com

# Verified sender in Resend (required on Vercel). Use an address on a domain you verified in Resend.
# Local dev: optional — falls back to onboarding@resend.dev if unset (Resend test limits apply).
CONTACT_FROM_EMAIL=AZUM Medical <hello@yourdomain.com>

# --- Cloudflare Turnstile (required on Vercel) ---
# https://dash.cloudflare.com → Turnstile → create widget → site key + secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# --- Optional: rate limiting (Upstash Redis) ---
# https://upstash.com — free tier. Limits each IP to 5 submissions/hour for /api/contact.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
